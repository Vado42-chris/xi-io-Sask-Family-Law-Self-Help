{
  "name": "xi-io-sask-family-law-self-help",
  "version": "0.1.0-preview.8",
  "private": true,
  "description": "Governed Saskatchewan family-law self-help workflow assistant with a plain-language local preview.",
  "type": "module",
  "scripts": {
    "check": "npm run check:foundation && npm run check:source-catalog && npm run check:source-coverage && npm run check:source-review-workbook && npm run check:source-review-completed && npm run check:applicability && npm run check:wizard-state && npm run check:preview && npm run check:user-language && npm run check:interaction-architecture && npm run check:app-proof-head",
    "check:foundation": "node scripts/check-foundation.mjs",
    "check:source-catalog": "node scripts/check-source-catalog.mjs",
    "check:source-coverage": "node scripts/check-source-coverage.mjs",
    "check:source-review-workbook": "node scripts/source-review-workbook.mjs --check",
    "check:source-review-completed": "node scripts/source-review-workbook.mjs --check-dispositions",
    "check:applicability": "node scripts/check-applicability-engine.mjs",
    "check:wizard-state": "node scripts/check-wizard-state.mjs",
    "check:preview": "node scripts/check-preview.mjs",
    "check:user-language": "node scripts/check-user-language.mjs",
    "check:interaction-architecture": "node scripts/check-interaction-architecture.mjs",
    "check:app-proof-head": "node scripts/check-app-proof-head.mjs",
    "check:browser-proof": "node scripts/check-user-geometry.mjs && npm run check:app-proof-head",
    "playwright:install": "npx playwright install chromium",
    "preview": "node scripts/serve-preview.mjs",
    "source-review:init": "node scripts/source-review-workbook.mjs",
    "source-review:validate": "node scripts/source-review-workbook.mjs",
    "fill:official-blank": "python3 scripts/form-fill/fill_official_blank.py"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "playwright": "^1.49.1"
  }
}

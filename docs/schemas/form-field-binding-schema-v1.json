{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-io.local/schemas/form-field-binding-schema-v1.json",
  "title": "Form-field bindings",
  "type": "object",
  "required": [
    "form_id",
    "snapshot_id",
    "bindings"
  ],
  "properties": {
    "form_id": {
      "type": "string"
    },
    "snapshot_id": {
      "type": "string"
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "binding_id",
          "source_snapshot_id",
          "fact_definition_id",
          "targets",
          "override_policy",
          "conflict_policy"
        ],
        "properties": {
          "binding_id": {
            "type": "string"
          },
          "source_snapshot_id": {
            "type": "string"
          },
          "fact_definition_id": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "minItems": 1
          },
          "override_policy": {
            "type": "string"
          },
          "conflict_policy": {
            "type": "string"
          },
          "source_line_item_hashes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

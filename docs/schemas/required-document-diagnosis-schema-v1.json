{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-io.local/schemas/required-document-diagnosis-schema-v1.json",
  "title": "Required document diagnosis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "diagnosis_id",
    "verification_state",
    "documents"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "diagnosis_id": { "type": "string", "minLength": 1 },
    "verification_state": {
      "type": "string",
      "enum": [
        "provisional_pending_source_review",
        "human_verified",
        "disputed",
        "stale"
      ]
    },
    "note": { "type": "string" },
    "procedural_stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_id", "label"],
        "properties": {
          "stage_id": { "type": "string" },
          "label": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "kind",
          "requirement_class",
          "title",
          "reason_required",
          "procedural_stage",
          "governing_source",
          "verification_state",
          "no_longer_required_when"
        ],
        "properties": {
          "document_id": { "type": "string" },
          "form_id": { "type": ["string", "null"] },
          "official_number": { "type": ["string", "null"] },
          "title": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": [
              "form_you_complete",
              "court_issued",
              "proof_and_service",
              "evidence_and_supporting",
              "procedural_action"
            ]
          },
          "requirement_class": {
            "type": "string",
            "enum": [
              "required_now",
              "required_later",
              "already_filed",
              "court_issued",
              "conditional",
              "not_applicable",
              "source_missing",
              "needs_human_confirmation"
            ]
          },
          "reason_required": { "type": "string" },
          "procedural_stage": { "type": "string" },
          "who_for": { "type": "string" },
          "when_needed": { "type": "string" },
          "governing_source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "citation", "source_date", "snapshot_id"],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "kit_form",
                  "kit_direction",
                  "workflow_stage",
                  "court_correspondence",
                  "companion_form_gap"
                ]
              },
              "citation": { "type": "string" },
              "source_date": { "type": "string" },
              "snapshot_id": { "type": "string" },
              "artifact_ref": { "type": ["string", "null"] }
            }
          },
          "verification_state": {
            "type": "string",
            "enum": ["provisional", "verified", "disputed", "blocked"]
          },
          "no_longer_required_when": { "type": "string" },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          },
          "supports": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "readiness_checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "label", "category"],
        "properties": {
          "item_id": { "type": "string" },
          "label": { "type": "string" },
          "category": {
            "type": "string",
            "enum": [
              "form",
              "supporting",
              "external",
              "signature",
              "service",
              "filing",
              "source",
              "review"
            ]
          },
          "document_id": { "type": ["string", "null"] },
          "required_for_package": { "type": "boolean" }
        }
      }
    }
  }
}

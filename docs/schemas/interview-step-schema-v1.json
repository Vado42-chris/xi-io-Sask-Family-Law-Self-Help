{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-io.local/schemas/interview-step-schema-v1.json",
  "title": "Interview steps and dispositions",
  "type": "object",
  "required": ["form_id", "snapshot_id", "line_item_dispositions", "steps"],
  "additionalProperties": false,
  "properties": {
    "form_id": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "line_item_dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["form_id", "line_item_id", "disposition", "source_line_item_hash"],
        "additionalProperties": false,
        "properties": {
          "form_id": { "type": "string" },
          "line_item_id": { "type": "string" },
          "source_line_item_hash": { "type": "string", "minLength": 64, "maxLength": 64 },
          "disposition": {
            "enum": [
              "asked_directly",
              "grouped_into_step",
              "derived_from_fact",
              "copied_from_existing_fact",
              "display_only",
              "court_only",
              "signature_workflow",
              "attachment_workflow",
              "not_applicable",
              "blocked_pending_review"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "interaction_step_id",
          "title",
          "order",
          "fields",
          "fact_definition_ids",
          "line_item_ids",
          "output_bindings",
          "presentation_id"
        ],
        "properties": {
          "interaction_step_id": { "type": "string" },
          "title": { "type": "string" },
          "order": { "type": "integer" },
          "estimated_minutes": { "type": "integer" },
          "section_goal": { "type": "string" },
          "presentation_id": { "type": "string" },
          "fact_definition_ids": { "type": "array", "items": { "type": "string" } },
          "line_item_ids": { "type": "array", "items": { "type": "string" } },
          "input_bindings": { "type": "array", "items": { "type": "string" } },
          "output_bindings": { "type": "array", "items": { "type": "string" } },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "field_token",
                "fact_definition_id",
                "line_item_id",
                "label",
                "control",
                "value_type",
                "required_rule",
                "binding_id"
              ],
              "properties": {
                "field_token": { "type": "string" },
                "fact_definition_id": { "type": "string" },
                "line_item_id": { "type": "string" },
                "label": { "type": "string" },
                "control": { "type": "string" },
                "value_type": { "type": "string" },
                "required_rule": { "type": "string" },
                "binding_id": { "type": "string" },
                "options": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
